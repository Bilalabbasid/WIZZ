# =========================================================
# WIZZ.PK PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# For Cloudways (see CLOUDWAYS_DEPLOYMENT.md) and Hostinger (HOSTINGER_DEPLOYMENT.md)
# Placeholders only: never commit real values.
# =========================================================

# --- Runtime & Networking ---
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
APP_URL="https://wizz.pk"
NEXT_PUBLIC_APP_URL="https://wizz.pk"
BRAND_NAME="WIZZ.PK"
DEFAULT_CURRENCY="PKR"
DEFAULT_LOCALE="en-PK"

# --- Production PostgreSQL Connection ---
# Use SSL connection parameters required by Hostinger / Cloud PostgreSQL
# e.g.: postgresql://db_user:strong_password@hostinger_db_host:5432/wizz_pk_prod?schema=public&sslmode=prefer&connection_limit=10
DATABASE_URL="postgresql://db_user:strong_password@127.0.0.1:5432/wizz_pk_prod?schema=public&connection_limit=10"

# --- Security, Session & Webhook Secrets ---
# MUST be unique, cryptographically random strings (minimum 32 characters)
# Generate via: openssl rand -base64 32
JWT_SECRET="replace-with-a-cryptographically-random-32-byte-secret"
SESSION_COOKIE_NAME="wizz_session"
SESSION_EXPIRY_DAYS=7
CRON_SECRET="replace-with-a-cryptographically-random-cron-secret"
PAYMENT_WEBHOOK_SECRET="replace-with-a-cryptographically-random-webhook-secret"

# --- Production bootstrap (scripts/bootstrap-production.ts, run by `npm run deploy:build`) ---
# Creates this platform admin once. ADMIN_RESET_PASSWORD=true re-applies the password on the next deploy.
ADMIN_EMAIL="admin@your-domain.pk"
ADMIN_PASSWORD="replace-with-a-strong-admin-password"
# ADMIN_RESET_PASSWORD="true"
# Staging only: loads the 52-product demo catalog (archives published products not in the demo list)
# SEED_DEMO_CATALOG="true"

# --- Object Storage & Media Uploads ---
# Option A: Hostinger Persistent Local Directory (VPS or persistent disk)
# Point UPLOAD_DIR to a directory outside the ephemeral build folder that persists across deploys.
UPLOAD_DIR="./.uploads"

# Option B: S3-Compatible Object Storage (Recommended for Cloud / Zero-Data-Loss)
# Compatible with Hostinger Object Storage, Cloudflare R2, AWS S3, or Wasabi
# S3_BUCKET="wizz-pk-production-media"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="replace-with-s3-access-key-id"
# S3_SECRET_ACCESS_KEY="replace-with-s3-secret-access-key"
# S3_PUBLIC_URL="https://media.wizz.pk"

# --- Transactional Email (SMTP) ---
# Hostinger Business Email or Transactional SMTP provider (SendGrid, Postmark, Amazon SES)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="orders@wizz.pk"
SMTP_PASSWORD="replace-with-hostinger-email-password"
SMTP_FROM="WIZZ.PK Customer Experience <orders@wizz.pk>"
# (SMTP_PASS / EMAIL_FROM are also accepted for older setups)

# --- Commercial & Feature Flag Rules ---
FEATURE_SELLER_PORTAL_ACTIVE="true"
FEATURE_MARKETPLACE_SETTLEMENTS="true"
FEATURE_GUEST_CHECKOUT="true"
FEATURE_REVIEWS_MODERATION="true"
COD_MAX_LIMIT_PKR=50000
